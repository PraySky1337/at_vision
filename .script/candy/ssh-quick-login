#!/usr/bin/env python3
"""
Configure passwordless SSH using workspace .config/ssh.cfg, then log in.

Reads host/port/user/identity from the TOML config, uploads the public key via
ssh-copy-id, and finally opens an SSH session to the target.
"""

import getpass
import shutil
import subprocess
import sys
from pathlib import Path


def load_toml(path: Path):
    """Lightweight TOML loader with minimal dependencies."""
    try:
        import tomllib  # Python 3.11+

        with path.open("rb") as f:
            return tomllib.load(f)
    except ModuleNotFoundError:
        try:
            import tomli  # type: ignore

            with path.open("rb") as f:
                return tomli.load(f)
        except ModuleNotFoundError:
            data = {}
            current = data
            for raw in path.read_text().splitlines():
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("[") and line.endswith("]"):
                    section = line[1:-1].strip()
                    current = data.setdefault(section, {})
                    continue
                if "=" not in line:
                    continue
                key, val = [p.strip() for p in line.split("=", 1)]
                if val.startswith(("'", '"')) and val.endswith(("'", '"')):
                    val = val[1:-1]
                else:
                    try:
                        val = int(val)
                    except ValueError:
                        try:
                            val = float(val)
                        except ValueError:
                            if val.lower() in ("true", "false"):
                                val = val.lower() == "true"
                current[key] = val
            return data


def resolve_config():
    ws_root = Path(__file__).resolve().parents[2]
    cfg_path = ws_root / ".config" / "ssh.cfg"
    if not cfg_path.exists():
        raise FileNotFoundError(f"config not found: {cfg_path}")
    cfg = load_toml(cfg_path)
    ssh_cfg = cfg.get("ssh", cfg)
    host = ssh_cfg.get("host")
    port = ssh_cfg.get("port", 22)
    user = ssh_cfg.get("user") or ssh_cfg.get("username")
    identity = ssh_cfg.get("identity")
    if not host:
        raise ValueError(f"missing 'host' in {cfg_path}")
    try:
        port = int(port)
    except (TypeError, ValueError):
        port = 22
    if "@" in host:
        dest = host
    else:
        dest = f"{user or getpass.getuser()}@{host}"
    return dest, port, identity


def resolve_key_path(identity: str | None):
    ssh_dir = Path.home() / ".ssh"
    ssh_dir.mkdir(mode=0o700, exist_ok=True)
    if identity:
        key_path = Path(identity).expanduser()
        if not key_path.exists():
            raise FileNotFoundError(f"identity file not found: {key_path}")
        return key_path

    candidates = [ssh_dir / "id_ed25519", ssh_dir / "id_rsa"]
    for cand in candidates:
        if cand.exists():
            return cand

    key_path = candidates[0]
    print(f"[ssh-quick-login] generating SSH key at {key_path} ...")
    subprocess.run(
        ["ssh-keygen", "-t", "ed25519", "-f", str(key_path), "-N", ""], check=True
    )
    return key_path


def ensure_pub_key(key_path: Path):
    if key_path.suffix == ".pub":
        return key_path
    pub_path = (
        key_path.with_suffix(key_path.suffix + ".pub")
        if key_path.suffix
        else key_path.with_suffix(".pub")
    )
    if pub_path.exists():
        return pub_path

    print(f"[ssh-quick-login] deriving public key {pub_path} ...")
    with pub_path.open("w", encoding="utf-8") as f:
        subprocess.run(["ssh-keygen", "-y", "-f", str(key_path)], check=True, stdout=f)
    return pub_path


def copy_key(dest: str, port: int, pub_path: Path):
    cmd = [
        "ssh-copy-id",
        "-o",
        "StrictHostKeyChecking=accept-new",
        "-p",
        str(port),
        "-i",
        str(pub_path),
        dest,
    ]
    print(f"[ssh-quick-login] uploading {pub_path} to {dest}:{port} ...")
    subprocess.run(cmd, check=True)


def main():
    if not shutil.which("ssh-copy-id"):
        print("[ssh-quick-login] ssh-copy-id not found in PATH.")
        return 1

    try:
        dest, port, identity = resolve_config()
    except Exception as exc:  # noqa: BLE001
        print(f"[ssh-quick-login] {exc}")
        return 1

    try:
        key_path = resolve_key_path(identity)
        pub_path = ensure_pub_key(key_path)
    except subprocess.CalledProcessError as exc:
        print(f"[ssh-quick-login] ssh-keygen failed: {exc}")
        return exc.returncode
    except Exception as exc:  # noqa: BLE001
        print(f"[ssh-quick-login] {exc}")
        return 1

    try:
        copy_key(dest, port, pub_path)
    except subprocess.CalledProcessError as exc:
        print(f"[ssh-quick-login] ssh-copy-id failed (returncode={exc.returncode}).")
        return exc.returncode

    print(f"[ssh-quick-login] connecting to {dest}:{port} ...")
    return subprocess.call(["ssh", "-o", "StrictHostKeyChecking=accept-new", "-p", str(port), dest])


if __name__ == "__main__":
    sys.exit(main())
