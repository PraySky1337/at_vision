#!/usr/bin/env bash
echo "=========================================="
echo "🚀 ATVision Entrypoint"
echo "=========================================="

# 确保 HOME 目录存在
export HOME=${HOME:-/home/developer}

# 若在容器中则执行特定启动逻辑
if [[ "${IN_DOCKER:-false}" == "true" ]]; then
    echo "[INFO] Detected running inside Docker."

    # 确保 ROS 环境存在
    if [ -f "/opt/ros/$ROS_DISTRO/setup.bash" ]; then
        source "/opt/ros/$ROS_DISTRO/setup.bash"
    else
        echo "[WARN] ROS setup file not found at /opt/ros/$ROS_DISTRO/setup.bash"
    fi

    # 启动主 launch 文件
    echo "[INFO] Launching ROS2 bringup..."
    exec ros2 launch rm_bringup bringup.launch.py
else
    echo "[INFO] Not running in Docker (IN_DOCKER != true)"
    echo "[INFO] You can manually run: ros2 launch rm_bringup bringup.launch.py"
    exec bash
fi
