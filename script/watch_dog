#!/bin/python3
# -*- coding: utf-8 -*-
"""
watchdog_ros.py
纯 Python ROS2 版：监控若干节点的 heartbeat topic，
若任一节点心跳丢失或 topic 消失则杀死所有 ROS2 进程并重新启动 launch 文件。
"""

import os
import time
import subprocess
import threading
import signal
import sys
from typing import Dict

import rclpy
from rclpy.node import Node
from std_msgs.msg import Int32, Header, Bool, UInt32  # 常见 heartbeat 类型
from rclpy.qos import qos_profile_sensor_data


# ================== 配置 ==================
TIMEOUT = 10.0  # 每个节点超时
NAMESPACE = ""  # 例如 "/infantry_3"
NODE_NAMES = ["armor_detector", "armor_solver", "camera_node"]
WORKING_DIR = os.path.expanduser("~/fyt2024-main")
LAUNCH_FILE = "rm_bringup bringup.launch.py"
OUTPUT_FILE = os.path.join(WORKING_DIR, "screen.output")

RMW = "rmw_fastrtps_cpp"

# ================== 核心类 ==================
class HeartbeatWatchdog(Node):
    def __init__(self):
        super().__init__("heartbeat_watchdog")
        self.get_logger().info("Heartbeat watchdog started")

        # 每个 topic 最近一次接收时间
        self.last_recv: Dict[str, float] = {}
        self.lock = threading.Lock()

        # 动态订阅每个 heartbeat topic
        for name in NODE_NAMES:
            topic = f"{NAMESPACE}/{name}/heartbeat"
            sub = self.create_subscription(
                Header, topic, lambda msg, t=topic: self._cb(t), qos_profile_sensor_data
            )
            self.last_recv[topic] = time.monotonic()
            self.get_logger().info(f"Subscribed to {topic}")

        # 后台线程检测
        self.thread = threading.Thread(target=self._loop, daemon=True)
        self.thread.start()

    # 每收到一次心跳更新时间戳
    def _cb(self, topic):
        with self.lock:
            self.last_recv[topic] = time.monotonic()

    # 获取上次接收时间
    def _last(self, topic):
        with self.lock:
            return self.last_recv.get(topic, 0)

    # 检测循环
    def _loop(self):
        while rclpy.ok():
            now = time.monotonic()
            for topic in list(self.last_recv.keys()):
                dt = now - self._last(topic)
                if dt > TIMEOUT:
                    self.get_logger().error(f"Heartbeat timeout: {topic} ({dt:.1f}s)")
                    self.restart_ros()
                    break
            time.sleep(TIMEOUT)

    # 执行杀死+重启
    def restart_ros(self):
        self.get_logger().warn("Restarting all ROS2 nodes...")

        # 杀 ROS 相关进程
        subprocess.run(["pkill", "-f", "ros"], check=False)
        subprocess.run(["ros2", "daemon", "stop"], check=False)
        subprocess.run(["ros2", "daemon", "start"], check=False)

        # 启动 launch
        launch_cmd = f"bash -c 'cd {WORKING_DIR}; source /opt/ros/humble/setup.bash; " \
                     f"source install/setup.bash; ros2 launch {LAUNCH_FILE} > {OUTPUT_FILE} 2>&1 &'"
        subprocess.Popen(launch_cmd, shell=True)
        self.get_logger().info("ROS bringup restarted.")

        # 重置计时
        now = time.monotonic()
        with self.lock:
            for k in self.last_recv:
                self.last_recv[k] = now


# ================== 启动入口 ==================
def main():
    os.environ["RMW_IMPLEMENTATION"] = RMW
    os.environ["ROS_LOG_DIR"] = "/tmp"
    os.environ["ROS_HOSTNAME"] = os.uname().nodename

    rclpy.init()
    node = HeartbeatWatchdog()

    # 信号处理（Ctrl-C 安全退出）
    def shutdown(signum, frame):
        node.get_logger().info("Shutting down watchdog.")
        rclpy.shutdown()
        sys.exit(0)

    signal.signal(signal.SIGINT, shutdown)
    signal.signal(signal.SIGTERM, shutdown)

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.get_logger().info("Watchdog stopped.")
        rclpy.shutdown()


if __name__ == "__main__":
    main()

